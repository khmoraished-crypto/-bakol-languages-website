# ─────────────────────────────────────────────────────────────
# AI Media Lab — إعدادات ربط نموذج الذكاء الاصطناعي (اختياري)
# انسخ هذا الملف إلى .env.local ثم املأ القيم.
# هذه المتغيرات تُقرأ على الخادم فقط ولا تصل إلى المتصفح أبدًا.
# لا تضف البادئة NEXT_PUBLIC_ إلى أي مفتاح.
# ─────────────────────────────────────────────────────────────

# المزوّد: anthropic | openai | none  (none = الوضع التجريبي القالبي)
AI_PROVIDER=none

# مفتاح الواجهة البرمجية للمزوّد المختار
AI_API_KEY=

# اسم النموذج (اختياري — توجد قيم افتراضية لكل مزوّد)
# أمثلة: claude-sonnet-5-5  |  gpt-4o-mini
AI_MODEL=

# عنوان مخصص لواجهة متوافقة مع OpenAI (اختياري)
# AI_BASE_URL=https://api.openai.com/v1

# الحد الأقصى للطلبات لكل عنوان IP في الدقيقة
AI_RATE_LIMIT_PER_MINUTE=20
